# Optional: force the AI detector device ("cpu" or "0"); default = CUDA when the installed torch build can use the GPU, else CPU
# AI_DEVICE = cpu

# Optional: work-arounds for the AI detector on old CPUs / VMs (run python313\python.exe ai\doctor.py to check)
# AI_NO_MKLDNN = 1
# AI_TORCH_THREADS = 2

# Optional: detector backend - torch (default) or onnx (OpenCV DNN on ai/trained_models/<model>.onnx, no torch; the worker switches to it by itself when torch crashes)
# AI_BACKEND = onnx
