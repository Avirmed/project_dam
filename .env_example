# Optional: private worker data folder (snapshots, CSV logs, FTP queues); default <project>\RTU Data
# RTU_DATA_PATH = D:\RTU Data

# Optional: interpreter for the ai/ scripts (RTSP capture, YOLO detection); default = the one running app.py
